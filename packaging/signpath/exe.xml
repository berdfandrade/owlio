<?xml version="1.0" encoding="utf-8"?>
<!-- Configuração de artefato "exe" da SignPath: o artefato do GitHub é um zip com um único .exe
     (o owlio.exe ou o instalador), assinado com Authenticode. Cole no projeto "owlio" da SignPath. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*.exe" max-matches="1">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
