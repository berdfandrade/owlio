/*
 * Tema do Owlio.
 * Os tokens @nome são trocados pelas cores do tema (claro/escuro) em theme.cpp.
 * Para editar com recarga ao vivo:  OWLIO_QSS=resources/themes/estilo.qss ./run.sh
 */

* { outline: 0; }

QMainWindow, QDialog { background: @window; }
/* Divisor entre painéis: 5px para dar onde pegar, mas só a linha do meio aparece. */
QMainWindow::separator { background: @border; border: 2px solid @surface; width: 5px; height: 5px; }
QMainWindow::separator:hover { background: @accent; }

/* ---------- menus ---------- */
QMenuBar {
    background: @window;
    color: @muted;
    padding: 6px 8px 3px 4px;
    spacing: 2px;
    font-weight: 500;
}
QMenuBar::item { padding: 6px 12px; border-radius: 7px; background: transparent; color: @muted; }
QMenuBar::item:selected { background: @hover; color: @text; }
QMenuBar::item:pressed { background: @selected; color: @accent; }
QLabel#marca { padding: 4px 8px 0 14px; }
QToolButton#botaoMenu { padding: 5px; border-radius: 7px; }
QToolButton#botaoMenu:hover { background: @hover; }

QMenu {
    background: @raised;
    color: @text;
    border: 1px solid @border;
    border-radius: 12px;
    padding: 6px;
}
QMenu::item { padding: 7px 34px 7px 34px; border-radius: 7px; background: transparent; }
QMenu::item:selected { background: @hover; color: @text; }
QMenu::item:disabled { color: @muted; }
QMenu::separator { height: 1px; background: @border; margin: 5px 10px; }
QMenu::icon { padding-left: 10px; }
QMenu::indicator { width: 16px; height: 16px; left: 9px; }
QMenu::indicator:checked { image: url(@check); }
QMenu::right-arrow { image: url(@submenu); width: 14px; height: 14px; right: 10px; }

/* ---------- barra de ferramentas ---------- */
QToolBar {
    background: @window;
    border: none;
    border-bottom: 1px solid @border;
    padding: 7px 12px;
    spacing: 2px;
}
QToolBar::separator { background: @border; width: 1px; margin: 7px 10px; }
QToolButton {
    color: @text;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 8px;
}
QToolButton:hover { background: @hover; }
QToolButton:pressed, QToolButton:checked { background: @selected; }
QToolButton:disabled { color: @muted; }
QToolButton#segmento { padding: 6px 10px; margin: 0 2px; color: @muted; }
QToolButton#segmento:checked { background: @selected; color: @text; }

QToolButton#primario {
    background: @accent;
    color: @accentText;
    padding: 6px 14px;
    font-weight: 600;
}
QToolButton#primario:hover { background: @accentHover; }
QToolButton#botaoQuadro { background: @surface; border: 1px solid @border; border-radius: 10px; padding: 0; }
QToolButton#botaoQuadro:hover { background: @hover; }
QToolButton#botaoQuadro:checked { background: @selected; border-color: @accent; }

/* ---------- campos ---------- */
QComboBox {
    background: @surface;
    color: @text;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 5px 30px 5px 10px;
    min-height: 20px;
    combobox-popup: 0;  /* lista abaixo do combo; no modo "menu" o Fusion pinta um painel quadrado por trás */
}
QComboBox:hover { border-color: @accent; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border: none;
}
QComboBox::down-arrow { image: url(@arrow); width: 14px; height: 14px; }
QComboBoxPrivateContainer { background: transparent; border: none; padding: 0; margin: 0; }
QComboBox QAbstractItemView {
    background: @raised;
    color: @text;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: @accent;
    selection-color: @accentText;
}
QComboBox#plano { background: transparent; border-color: transparent; padding: 2px 26px 2px 8px; }
QComboBox#plano:hover { background: @hover; }

QLineEdit, QPlainTextEdit {
    background: @surface;
    color: @text;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 6px 8px;
    selection-background-color: @accent;
    selection-color: @accentText;
}
QLineEdit:focus, QPlainTextEdit:focus { border-color: @accent; }

QPushButton {
    background: @raised;
    color: @text;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 6px 16px;
    min-width: 60px;
}
QPushButton:hover { background: @hover; }
QPushButton:pressed { background: @selected; }
QPushButton:default { background: @accent; color: @accentText; border-color: @accent; }
QPushButton:default:hover { background: @accentHover; }

QLabel { color: @text; background: transparent; }
QToolTip {
    background: @raised;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 5px 8px;
}

/* ---------- janelas de diálogo ---------- */
QLabel#tituloDialogo { font-size: 20px; font-weight: 700; color: @text; }
QLabel#subtituloDialogo { color: @muted; }
QLabel#secao { color: @muted; font-size: 11px; font-weight: 700; padding-top: 4px; }
QLineEdit#campoTitulo { font-size: 15px; font-weight: 600; padding: 8px 10px; }
QWidget#painelLateral { background: @surface; border-left: 1px solid @border; }
QFrame#ficha { background: @canvas; border-radius: 14px; }
QLabel#nomeFicha { font-size: 17px; font-weight: 700; color: @text; }
QFrame#ficha QListWidget { background: transparent; padding: 0; }
QFrame#estatisticas { background: @surface; border: 1px solid @border; border-radius: 10px; }
QFrame#estatisticas QLabel { color: @text; background: transparent; }
QFrame#divisor { background: @border; margin: 4px 0; }
QLabel#papelFicha { color: @accent; font-weight: 600; }
QPushButton#perigo { color: #e5484d; background: transparent; border-color: transparent; }
QPushButton#perigo:hover { background: @hover; }
QPushButton#primarioBotao { background: @accent; color: @accentText; border-color: @accent; font-weight: 600; }
QPushButton#primarioBotao:hover { background: @accentHover; }
QPushButton#primarioBotao:disabled { background: @hover; color: @muted; border-color: @border; }
QPushButton#link { color: @accent; background: transparent; border: none; padding: 4px 0; min-width: 0; text-align: left; }
QPushButton#link:hover { text-decoration: underline; }
QPushButton#link { qproperty-iconSize: 15px 15px; }
/* Máquina do tempo (versões): botões sobre o céu escuro, iguais nos dois temas. */
QPushButton#versaoBotao, QPushButton#versaoRestaurar {
    background: rgba(255, 255, 255, 0.12); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 12px; font-weight: 600; padding: 0 18px;
}
QPushButton#versaoBotao:hover { background: rgba(255, 255, 255, 0.22); }
QPushButton#versaoRestaurar { background: #3b6cf6; border-color: #6c8cff; }
QPushButton#versaoRestaurar:hover { background: #2f5be0; }
QPushButton#versaoRestaurar:disabled { background: rgba(255, 255, 255, 0.06); color: rgba(255, 255, 255, 0.35); border-color: rgba(255, 255, 255, 0.12); }
/* Enviar foto / Criar avatar, na ficha do personagem. */
QPushButton#acaoFoto {
    background: @surface; color: @text; border: 1px solid @border; border-radius: 10px;
    padding: 0 8px; min-width: 0; font-weight: 600;
}
QPushButton#acaoFoto:hover { background: @selected; border-color: @accent; color: @accent; }
QPushButton#acaoFoto:pressed { background: @hover; }
QLabel#amostraAvatar { background: transparent; }
QToolButton#categoria {
    background: @surface; border: 1px solid @border; border-radius: 12px; padding: 8px 6px 6px 6px;
    color: @muted; font-size: 11px;
}
QToolButton#categoria:hover { background: @hover; color: @text; }
QToolButton#categoria:checked { background: @selected; border-color: @accent; color: @accent; }
QListWidget#opcoesAvatar { background: @surface; border: 1px solid @border; border-radius: 12px; padding: 8px; }
QListWidget#opcoesAvatar::item { border: 2px solid transparent; border-radius: 12px; }
QListWidget#opcoesAvatar::item:hover { background: @hover; }
QListWidget#opcoesAvatar::item:selected { background: transparent; border-color: @accent; }
QToolButton#corAvatar { border: 2px solid @border; border-radius: 16px; }
QToolButton#corAvatar:hover { border-color: @text; }
QToolButton#corAvatar:checked { border: 3px solid @accent; }
QLabel#nomeAvatar { font-size: 15px; font-weight: 700; color: @text; }
QLabel#rotuloAvatar { color: @muted; font-size: 11px; font-weight: 700; }
QPushButton#botaoIconeAvatar { padding: 0; min-width: 38px; max-width: 38px; min-height: 38px; max-height: 38px; border-radius: 10px; }
QToolButton#corpo {
    background: @surface; border: 1px solid @border; border-radius: 10px; color: @muted; padding: 0 14px; font-weight: 600;
}
QToolButton#corpo:hover { background: @hover; color: @text; }
QToolButton#corpo:checked { background: @selected; color: @accent; border-color: @accent; }
QSpinBox {
    background: @surface; color: @text; border: 1px solid @border; border-radius: 8px;
    padding: 5px 8px; selection-background-color: @accent;
}
QSpinBox:focus { border-color: @accent; }
QSpinBox::up-button, QSpinBox::down-button { width: 0; border: none; }
QCheckBox { color: @text; spacing: 8px; padding: 3px 0; }
QCheckBox::indicator {
    width: 16px; height: 16px; border-radius: 4px;
    border: 1px solid @border; background: @surface;
}
QCheckBox::indicator:hover { border-color: @accent; }
QCheckBox::indicator:checked { background: @accent; border-color: @accent; image: url(@checkWhite); }
QCheckBox::indicator:disabled { background: @hover; }
QCheckBox:disabled { color: @muted; }
QToolButton#segmento { border: 1px solid @border; }
QToolButton#segmento:checked { border-color: @accent; }

/* ---------- atalhos ---------- */
QLabel#tecla {
    background: @raised; color: @text; border: 1px solid @border; border-bottom-width: 2px;
    border-radius: 6px; padding: 2px 7px; font-weight: 600; font-size: 12px; min-width: 12px;
}
QLabel#teclaSep { color: @muted; }

/* ---------- configurações ---------- */
QWidget#ladoConfig { background: @surface; border-right: 1px solid @border; }
QLabel#tituloNav { color: @text; font-size: 15px; font-weight: 700; padding: 0 8px 6px 8px; }
QListWidget#listaPalavras { background: @surface; border: 1px solid @border; border-radius: 10px; padding: 6px; outline: none; }
QListWidget#listaPalavras::item { border-radius: 6px; padding: 5px 8px; color: @text; }
QListWidget#listaPalavras::item:hover { background: @hover; }
QListWidget#listaPalavras::item:selected { background: @selected; color: @text; }
QListWidget#navConfig { background: transparent; padding: 0; outline: none; }
QListWidget#navConfig::item { border-radius: 8px; padding: 0 8px; margin: 1px 0; color: @text; }
QListWidget#navConfig::item:hover { background: @hover; }
QListWidget#navConfig::item:selected { background: @selected; color: @text; }
QLabel#amostraInterface {
    background: @surface; border: 1px solid @border; border-radius: 8px; padding: 10px 12px; color: @text;
}
QLabel#amostraRoteiro {
    background: #ffffff; color: #1a1a1a; border: 1px solid @border; border-radius: 8px; padding: 14px 16px;
}
QScrollArea#paginaConfig, QScrollArea#paginaConfig > QWidget > QWidget { background: transparent; }

/* ---------- painéis laterais ---------- */
QDockWidget { color: @muted; }
QWidget#cabecalhoPainel { background: @surface; }
QToolButton#botaoPainel { background: transparent; border: none; border-radius: 6px; padding: 4px; }
QToolButton#botaoPainel:hover { background: @hover; }
QLabel#tituloPainel {
    background: @surface;
    color: @muted;
    padding: 8px 16px 8px 16px;  /* + 6px do cabeçalho */
    font-size: 11px;
    font-weight: 700;
}
QListWidget {
    background: @surface;
    color: @text;
    border: none;
    padding: 2px 0 8px 0;
}

/* ---------- barra de status ---------- */
QStatusBar {
    background: @window;
    color: @muted;
    border-top: 1px solid @border;
    min-height: 28px;
}
QStatusBar::item { border: none; }
QStatusBar QLabel { color: @muted; padding: 0 10px; }

/* ---------- rolagem ---------- */
QScrollBar:vertical { background: transparent; width: 12px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 12px; margin: 2px; }
QScrollBar::handle:vertical { background: @scroll; border-radius: 4px; min-height: 40px; margin: 0 2px; }
QScrollBar::handle:horizontal { background: @scroll; border-radius: 4px; min-width: 40px; margin: 2px 0; }
QScrollBar::handle:hover { background: @muted; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------- área das páginas ---------- */
ScriptView { background: @canvas; border: none; }

/* ---------- personagens, linha do tempo ---------- */
QTreeWidget#tabelaElenco {
    background: @surface; alternate-background-color: @window; color: @text;
    border: 1px solid @border; border-radius: 12px; padding: 4px; outline: 0;
}
QTreeWidget#tabelaElenco::item { padding: 2px 6px; border: none; }
QTreeWidget#tabelaElenco::item:hover { background: @hover; }
QTreeWidget#tabelaElenco::item:selected { background: @selected; color: @text; }
QTreeWidget#tabelaElenco QHeaderView::section {
    background: @surface; color: @muted; border: none; border-bottom: 1px solid @border;
    padding: 8px 8px; font-weight: 600;
}
QTreeWidget#tabelaElenco QLineEdit, QTreeWidget#tabelaElenco QComboBox { padding: 2px 6px; }
QProgressBar#progressoFilme { background: @border; border: none; border-radius: 4px; }
QProgressBar#progressoFilme::chunk { background: @accent; border-radius: 4px; }
QToolButton#alternarLinha {
    background: @surface; border: 1px solid @border; border-radius: 8px; padding: 6px 12px; color: @text;
}
QToolButton#alternarLinha:hover { background: @hover; }
QToolButton#alternarLinha:checked { background: @selected; border-color: @accent; color: @accent; }
